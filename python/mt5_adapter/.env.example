# Скопировать в .env рядом с app.py и поправить значения.
# Переменные, уже заданные в окружении процесса, имеют приоритет над этим файлом.

# Адрес и порт HTTP-сервера. Для доступа с Mac из Windows-VM нужен 0.0.0.0
MT5_ADAPTER_HOST=127.0.0.1
MT5_ADAPTER_PORT=8080

# На какой тип счёта в терминале разрешено открывать ордера: demo или real
MT5_ALLOWED_ACCOUNT_MODE=demo
