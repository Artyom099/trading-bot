# Скопировать в .env рядом с этим файлом и заполнить.
# Сервис читает его при старте из trader/ (../deploy/compose/trader/.env).
# Переменные, уже заданные в окружении процесса, имеют приоритет над файлом.

# ----------------------------
# Настройки Telegram бота
# ----------------------------

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата, который слушает trader (сообщения из других чатов игнорируются).
# Личный чат с ботом: положительное число. Канал: отрицательное, вида -100...
# Для канала бот должен быть админом, иначе не получит channel_post.
TELEGRAM_BOT_CHAT_ID=

# ----------------------------
# MT5 адаптер
# ----------------------------

# Адрес Python-адаптера. Если адаптер в Windows-VM: http://<IP-VM>:8080
MT5_ADAPTER_URL=http://127.0.0.1:8080

# ----------------------------
# Торговля
# ----------------------------

# Объём сделки в лотах на каждую цель сигнала (в сигнале из Telegram его нет).
# На каждую цель (TP1, TP2, TP3) открывается отдельная сделка со своим TP.
# 0 — сделку на эту цель не открывать. Если в сигнале нет целей — ничего не открывается.
TRADE_VOLUME_TP1=0.01
TRADE_VOLUME_TP2=0.01
TRADE_VOLUME_TP3=0.01

# Необязательно. Сообщения старше этого возраста пропускаются (30s, 2m ...).
# 0 — не фильтровать. По умолчанию 60s.
TRADE_MAX_SIGNAL_AGE=60s

# ----------------------------
# Стоп-кран
# ----------------------------
# Команды в рабочем чате: /stop — остановить торговлю, /start — включить, /status — состояние.
# Остановленный trader не открывает новые сделки (открытые позиции не трогает).
# Состояние «остановлено» сохраняется в файле и переживает перезапуск.

# Автоматический стоп после N неудачных сделок подряд. 0 — не проверять. По умолчанию 5.
KILLSWITCH_MAX_CONSECUTIVE_ERRORS=5

# Автоматический стоп, когда за 24 часа принято больше N сигналов. 0 — не проверять. По умолчанию 20.
KILLSWITCH_MAX_SIGNALS_PER_DAY=20

# Файл состояния. По умолчанию рядом с .env.
KILLSWITCH_STATE_FILE=../deploy/compose/trader/killswitch.json

# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=false

LOGGER_ENABLE_OTLP=false
